rules_version = '2';
// Lenza Lenta cloud backup (src/core/cloud.js): one document per player, saves/{uid}.
// A signed-in player reads and writes only their own document; nobody lists, and nothing else exists.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'saved', 'day', 'device', 'v', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }
  }
}
